# ============================================
# FOOD DELIVERY PLATFORM - ENVIRONMENT VARIABLES
# ============================================
# Copy this file to .env and update the values
# ============================================

# ============================================
# DATABASE CONFIGURATION
# ============================================
# PostgreSQL connection settings
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# Individual database names
DB_USER=userdb
DB_RESTAURANT=restaurantdb
DB_ORDER=orderdb
DB_DELIVERY=deliverydb
DB_PAYMENT=paymentdb
DB_REVIEW=reviewdb
DB_COUPON=coupondb

# ============================================
# SECURITY
# ============================================
# JWT Secret for token generation (CHANGE IN PRODUCTION!)
JWT_SECRET=dev_secret_change_me_in_production

# ============================================
# SERVICE URLS (Docker Internal Network)
# ============================================
USER_SERVICE_URL=http://user-service:4001
RESTAURANT_SERVICE_URL=http://restaurant-service:4002
ORDER_SERVICE_URL=http://order-service:4003
DELIVERY_SERVICE_URL=http://delivery-service:4004
NOTIFICATION_SERVICE_URL=http://notification-service:4006
PAYMENT_SERVICE_URL=http://payment-service:4007
REVIEW_SERVICE_URL=http://review-service:4008
COUPON_SERVICE_URL=http://coupon-service:4009

# ============================================
# SERVICE PORTS
# ============================================
API_GATEWAY_PORT=4000
USER_SERVICE_PORT=4001
RESTAURANT_SERVICE_PORT=4002
ORDER_SERVICE_PORT=4003
DELIVERY_SERVICE_PORT=4004
NOTIFICATION_SERVICE_PORT=4006
PAYMENT_SERVICE_PORT=4007
REVIEW_SERVICE_PORT=4008
COUPON_SERVICE_PORT=4009
FRONTEND_PORT=3000

# ============================================
# FRONTEND CONFIGURATION
# ============================================
REACT_APP_API_URL=http://localhost:4000

# ============================================
# NOTIFICATION SERVICE (Optional)
# ============================================
# Email configuration (if using real email service)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your-email@gmail.com
# SMTP_PASSWORD=your-app-password

# SMS configuration (if using SMS service)
# TWILIO_ACCOUNT_SID=your-account-sid
# TWILIO_AUTH_TOKEN=your-auth-token
# TWILIO_PHONE_NUMBER=+1234567890

# ============================================
# PAYMENT GATEWAY (Optional)
# ============================================
# Stripe configuration (if using real payment gateway)
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_PUBLIC_KEY=pk_test_...

# PayPal configuration
# PAYPAL_CLIENT_ID=your-client-id
# PAYPAL_CLIENT_SECRET=your-client-secret
# PAYPAL_MODE=sandbox

# ============================================
# NODE ENVIRONMENT
# ============================================
NODE_ENV=production
